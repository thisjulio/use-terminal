{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "files": { "includes": ["**/*.ts", "**/*.mjs"] },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": "off",
      "complexity": { "noForEach": "error", "noStaticOnlyClass": "error" },
      "style": { "noNonNullAssertion": "off", "useConst": "error", "useImportType": "error" },
      "suspicious": { "noControlCharactersInRegex": "off" }
    }
  }
}
