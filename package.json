{
  "name": "use-terminal",
  "module": "index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun run index.ts",
    "start": "bun run index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "bun run lint && bun run typecheck && bun test",
    "demo:viewer": "bun run scripts/live-cagent-viewer.ts",
    "mcp": "bun run src/mcp.ts",
    "serve": "bun run scripts/rest-server.ts",
    "prepare": "husky",
    "test:manual:cagent": "bun run tests/manual/test-cagent-interactive.ts",
    "test:manual:tui": "bun run tests/manual/test-cagent-tui.ts",
    "test:diagnostics": "bun run tests/diagnostics/debug-session-data.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/bun": "latest",
    "husky": "^9.1.7"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@xterm/headless": "^6.0.0",
    "bun-pty": "^0.4.10"
  }
}
